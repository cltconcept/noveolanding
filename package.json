{
  "name": "noveo-landing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro check && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "format": "prettier --write \"src/**/*.{astro,ts,css,json}\" \"scripts/*.{mjs,html}\" *.mjs *.json README.md",
    "redirects": "node scripts/generate-redirects.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "astro": "7.3.4",
    "gsap": "3.15.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "axe-core": "^4.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.0.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
