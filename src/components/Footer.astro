---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { company, pageUrl, type Locale } from '../data/site';
import { translations } from '../data/translations';
import { services } from '../data/services';
interface Props {
  locale: Locale;
  showCta?: boolean;
}
const { locale, showCta = true } = Astro.props;
const t = translations[locale];
---

{showCta && (
  <section class="cta-section">
    <div class="cta-orbit" aria-hidden="true"></div>
    <div class="container cta-inner" data-reveal>
      <div>
        <p class="eyebrow">{t.cta.label}</p>
        <h2>
          {t.cta.title}
          <br />
          <span>{t.cta.accent}</span>
        </h2>
      </div>
      <div class="cta-actions">
        <a href={pageUrl(locale, 'contact')} class="button button-white">
          {t.cta.button}
          <Icon name="diagonal" size={20} />
        </a>
        <a href={company.calendly} target="_blank" rel="noopener noreferrer" class="text-link">
          {t.cta.alternative}
          <Icon name="diagonal" size={16} />
        </a>
      </div>
    </div>
  </section>
)}
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href={pageUrl(locale)} aria-label="Noveo Digital">
          <Logo />
        </a>
        <p>{t.cta.footerText}</p>
        <span class="footer-tag">
          <span class="status-dot"></span>
          {t.team.tag}
        </span>
      </div>
      <div>
        <h3>{t.cta.expertise}</h3>
        <ul>
          {services[locale].map((service) => (
            <li>
              <a href={pageUrl(locale, service.id)}>{service.name}</a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3>{t.cta.find}</h3>
        <a class="footer-mail" href={`mailto:${company.email}`}>
          {company.email}
          <Icon name="diagonal" size={16} />
        </a>
        <a href={company.phoneHref}>{company.phone}</a>
        <p class="footer-address">
          Chaussée de Louvain 435
          <br />
          1380 Lasne, {locale === 'nl' ? 'België' : locale === 'en' ? 'Belgium' : 'Belgique'}
        </p>
      </div>
    </div>
    <div class="footer-wordmark" aria-hidden="true">
      <svg viewBox="0 0 1000 235" fill="currentColor">
        <text x="0" y="205" font-size="280" letter-spacing="-20" font-weight="650">
          noveo
        </text>
        <text x="748" y="65" font-size="32" letter-spacing="0">
          ®
        </text>
      </svg>
      <p>{t.cta.footerLine}</p>
    </div>
    <div class="footer-bottom">
      <span>
        © {new Date().getFullYear()} Noveo Digital. {t.cta.copyright}
      </span>
      <div>
        <a href={pageUrl(locale, 'legal')}>{t.cta.legal}</a>
        <a href="/conditions-generales.pdf" target="_blank" rel="noopener noreferrer">
          {t.cta.terms} ↗
        </a>
      </div>
      <a href="#top" class="back-top" aria-label={t.cta.top}>
        <Icon name="arrow" size={20} />
      </a>
    </div>
  </div>
</footer>
